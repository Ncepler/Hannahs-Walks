# Server only. Never prefix a secret with NEXT_PUBLIC_.
# On Vercel, ANTHROPIC_API_KEY is the only one the chat box strictly needs; the rest are optional or for the Pages site.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PREMIUM_PASSCODE=
SITE_PASSCODE=
SESSION_SECRET=
# Premium called from another host (the GitHub Pages site): its origin, scheme and host only, comma-separated
# for more than one. Empty means same-site only. Leave SITE_PASSCODE empty on a host used this way.
ALLOWED_ORIGIN=
AI_DAILY_CAP=
# Public by design. Restrict by HTTP referrer to the production domain, Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Pages build only. Where the planner runs when the page is hosted somewhere else. Public by design.
NEXT_PUBLIC_API_BASE=
